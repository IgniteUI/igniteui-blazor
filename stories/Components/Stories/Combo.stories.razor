@attribute [Stories("Forms/Combo")]

<Stories TComponent="IgbCombo<string>">

    <ArgType For="_ => _!.GroupSorting" Control="ControlType.Radio" />

    <Story Name="Default">
        <Arguments>
            <Arg For="_ => _!.Label" Value='"Cities"' />
            <Arg For="_ => _!.Placeholder" Value='"Pick one or more cities"' />
            <Arg For="_ => _!.PlaceholderSearch" Value='"Search"' />
            <Arg For="_ => _!.ValueKey" Value='"Id"' />
            <Arg For="_ => _!.DisplayKey" Value='"Name"' />
            <Arg For="_ => _!.Outlined" Value="false" />
            <Arg For="_ => _!.Disabled" Value="false" />
        </Arguments>
        <Template>
            <IgbCombo T="string" Data="_cities" @attributes="context.Args" />
        </Template>
    </Story>

    <Story Name="Single Select">
        <Arguments>
            <Arg For="_ => _!.Label" Value='"City"' />
            <Arg For="_ => _!.Placeholder" Value='"Pick a city"' />
            <Arg For="_ => _!.ValueKey" Value='"Id"' />
            <Arg For="_ => _!.DisplayKey" Value='"Name"' />
            <Arg For="_ => _!.SingleSelect" Value="true" />
        </Arguments>
        <Template>
            <IgbCombo T="string" Data="_cities" @attributes="context.Args" />
        </Template>
    </Story>

    <Story Name="Grouped">
        <Arguments>
            <Arg For="_ => _!.Label" Value='"Cities by country"' />
            <Arg For="_ => _!.ValueKey" Value='"Id"' />
            <Arg For="_ => _!.DisplayKey" Value='"Name"' />
            <Arg For="_ => _!.GroupKey" Value='"Country"' />
            <Arg For="_ => _!.Outlined" Value="true" />
        </Arguments>
        <Template>
            <IgbCombo T="string" Data="_cities" @attributes="context.Args" />
        </Template>
    </Story>

    <Story Name="Preselected">
        <Arguments>
            <Arg For="_ => _!.Label" Value='"Cities"' />
            <Arg For="_ => _!.ValueKey" Value='"Id"' />
            <Arg For="_ => _!.DisplayKey" Value='"Name"' />
            <Arg For="_ => _!.Value" Value="_selectedCities" />
        </Arguments>
        <Template>
            <IgbCombo T="string" Data="_cities" @attributes="context.Args" />
        </Template>
    </Story>

    <Story Name="Disabled">
        <Arguments>
            <Arg For="_ => _!.Label" Value='"Cities"' />
            <Arg For="_ => _!.ValueKey" Value='"Id"' />
            <Arg For="_ => _!.DisplayKey" Value='"Name"' />
            <Arg For="_ => _!.Disabled" Value="true" />
        </Arguments>
        <Template>
            <IgbCombo T="string" Data="_cities" @attributes="context.Args" />
        </Template>
    </Story>

    <Story Name="Numeric Value Key">
        <Arguments>
            <Arg For="_ => _!.Label" Value='"Cities"' />
            <Arg For="_ => _!.Placeholder" Value='"Pick one or more cities"' />
            <Arg For="_ => _!.PlaceholderSearch" Value='"Search"' />
            <Arg For="_ => _!.Outlined" Value="false" />
            <Arg For="_ => _!.Disabled" Value="false" />
        </Arguments>
        <Template>
            @* Numeric (struct) value key - the combo value is an int[] matching the Id column. *@
            <IgbCombo T="int"
                      Data="_citiesWithNumericIds"
                      ValueKey="Id"
                      DisplayKey="Name"
                      GroupKey="Country"
                      @bind-Value="_selectedCityIds"
                      @attributes="context.Args" />
        </Template>
    </Story>

</Stories>

@code {
    private readonly string[] _selectedCities = ["BG01", "US01"];

    private readonly City[] _cities =
    [
        new("BG01", "Sofia", "Bulgaria"),
        new("BG02", "Plovdiv", "Bulgaria"),
        new("BG03", "Varna", "Bulgaria"),
        new("US01", "New York", "United States"),
        new("US02", "San Francisco", "United States"),
        new("US03", "Seattle", "United States"),
        new("UK01", "London", "United Kingdom"),
        new("UK02", "Manchester", "United Kingdom"),
        new("JP01", "Tokyo", "Japan"),
        new("JP02", "Osaka", "Japan")
    ];

    private readonly CityNumIds[] _citiesWithNumericIds =
    [
        new(1, "Sofia", "Bulgaria"),
        new(2, "Plovdiv", "Bulgaria"),
        new(3, "Varna", "Bulgaria"),
        new(4, "New York", "United States"),
        new(5, "San Francisco", "United States"),
        new(6, "Seattle", "United States"),
        new(7, "London", "United Kingdom"),
        new(8, "Manchester", "United Kingdom"),
        new(9, "Tokyo", "Japan"),
        new(10, "Osaka", "Japan")
    ];

    private int[] _selectedCityIds = [1, 4];

    private record City(string Id, string Name, string Country);
    private record CityNumIds(int Id, string Name, string Country);
}
