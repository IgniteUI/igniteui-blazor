@attribute [Stories("Forms/Combo")]

<Stories TComponent="IgbCombo<string, City>">

    <ArgType For="_ => _!.GroupSorting" Control="ControlType.Radio" />
    <ArgType For="_ => _!.ScrollStrategy" Control="ControlType.Radio" />
    <ArgType For="_ => _!.SelectionCommit" Control="ControlType.Radio" />

    <Story Name="Default">
        <Arguments>
            <Arg For="_ => _!.Label" Value='"Cities"' />
            <Arg For="_ => _!.Placeholder" Value='"Pick one or more cities"' />
            <Arg For="_ => _!.PlaceholderSearch" Value='"Search"' />
            <Arg For="_ => _!.ValueKey" Value='"Id"' />
            <Arg For="_ => _!.DisplayKey" Value='"Name"' />
            <Arg For="_ => _!.Outlined" Value="false" />
            <Arg For="_ => _!.Disabled" Value="false" />
        </Arguments>
        <Template>
            <IgbCombo TValue="string" TItem="City" Data="_cities" @attributes="context.Args" />
        </Template>
    </Story>

    <Story Name="Single Select">
        <Arguments>
            <Arg For="_ => _!.Label" Value='"City"' />
            <Arg For="_ => _!.Placeholder" Value='"Pick a city"' />
            <Arg For="_ => _!.ValueKey" Value='"Id"' />
            <Arg For="_ => _!.DisplayKey" Value='"Name"' />
            <Arg For="_ => _!.SingleSelect" Value="true" />
        </Arguments>
        <Template>
            <IgbCombo TValue="string" TItem="City" Data="_cities" @attributes="context.Args" />
        </Template>
    </Story>

    <Story Name="Grouped">
        <Arguments>
            <Arg For="_ => _!.Label" Value='"Cities by country"' />
            <Arg For="_ => _!.ValueKey" Value='"Id"' />
            <Arg For="_ => _!.DisplayKey" Value='"Name"' />
            <Arg For="_ => _!.GroupKey" Value='"Country"' />
            <Arg For="_ => _!.Outlined" Value="true" />
        </Arguments>
        <Template>
            <IgbCombo TValue="string" TItem="City" Data="_cities" @attributes="context.Args" />
        </Template>
    </Story>

    <Story Name="Templates">
        <Arguments>
            <Arg For="_ => _!.Label" Value='"Cities by country"' />
            <Arg For="_ => _!.ValueKey" Value='"Id"' />
            <Arg For="_ => _!.DisplayKey" Value='"Name"' />
            <Arg For="_ => _!.GroupKey" Value='"Country"' />
        </Arguments>
        <Template>
            <IgbCombo TValue="string" TItem="City" Data="_cities" @attributes="context.Args">
                <ItemTemplate Context="city">
                    <span><strong>@city.Name</strong> <small>(@city.Id)</small></span>
                </ItemTemplate>
                <GroupHeaderTemplate Context="group">
                    <span>🌍 @group.Key</span>
                </GroupHeaderTemplate>
            </IgbCombo>
        </Template>
    </Story>

    <Story Name="Preselected">
        <Arguments>
            <Arg For="_ => _!.Label" Value='"Cities"' />
            <Arg For="_ => _!.ValueKey" Value='"Id"' />
            <Arg For="_ => _!.DisplayKey" Value='"Name"' />
            <Arg For="_ => _!.Value" Value="_selectedCities" />
        </Arguments>
        <Template>
            <IgbCombo TValue="string" TItem="City" Data="_cities" @attributes="context.Args" />
        </Template>
    </Story>

    <Story Name="Disabled">
        <Arguments>
            <Arg For="_ => _!.Label" Value='"Cities"' />
            <Arg For="_ => _!.ValueKey" Value='"Id"' />
            <Arg For="_ => _!.DisplayKey" Value='"Name"' />
            <Arg For="_ => _!.Disabled" Value="true" />
        </Arguments>
        <Template>
            <IgbCombo TValue="string" TItem="City" Data="_cities" @attributes="context.Args" />
        </Template>
    </Story>

    <Story Name="Select All">
        <Arguments>
            <Arg For="_ => _!.Label" Value='"Cities by country"' />
            <Arg For="_ => _!.ValueKey" Value='"Id"' />
            <Arg For="_ => _!.DisplayKey" Value='"Name"' />
            <Arg For="_ => _!.GroupKey" Value='"Country"' />
            <Arg For="_ => _!.ShowSelectAll" Value="true" />
            <Arg For="_ => _!.GroupSelection" Value="true" />
        </Arguments>
        <Template>
            <IgbCombo TValue="string" TItem="City" Data="_cities" @attributes="context.Args" />
        </Template>
    </Story>

    <Story Name="Confirm Selection">
        <Arguments>
            <Arg For="_ => _!.Label" Value='"Cities"' />
            <Arg For="_ => _!.ValueKey" Value='"Id"' />
            <Arg For="_ => _!.DisplayKey" Value='"Name"' />
            <Arg For="_ => _!.SelectionCommit" Value="ComboSelectionCommit.Confirm" />
            <Arg For="_ => _!.ShowSelectAll" Value="true" />
        </Arguments>
        <Template>
            <IgbCombo TValue="string" TItem="City" Data="_cities" @attributes="context.Args"
                      PendingChange="OnPendingChange" Change="OnConfirmedChange" Closed="OnConfirmClosed" />
            <p>@_confirmLog</p>
        </Template>
    </Story>
</Stories>

@code {
    private string _confirmLog = "Toggle items, then press Enter or Apply.";

    private void OnPendingChange(IgbComboChangeEventArgs<string, City> args) =>
        _confirmLog = $"Pending: {args.Detail.ChangeType} {string.Join(", ", args.Detail.Items.Select(c => c.Name))}";

    private void OnConfirmedChange(IgbComboChangeEventArgs<string, City> args) =>
        _confirmLog = $"Applied ({args.Detail.ChangeType}): {string.Join(", ", args.Detail.NewValue)}";

    private void OnConfirmClosed(IgbComboClosingEventArgs args) =>
        _confirmLog += $" — closed by {args.Detail.Trigger}";

    private readonly string[] _selectedCities = ["BG01", "US01"];

    private readonly City[] _cities =
    [
        new("BG01", "Sofia", "Bulgaria"),
        new("BG02", "Plovdiv", "Bulgaria"),
        new("BG03", "Varna", "Bulgaria"),
        new("US01", "New York", "United States"),
        new("US02", "San Francisco", "United States"),
        new("US03", "Seattle", "United States"),
        new("UK01", "London", "United Kingdom"),
        new("UK02", "Manchester", "United Kingdom"),
        new("JP01", "Tokyo", "Japan"),
        new("JP02", "Osaka", "Japan")
    ];

    private record City(string Id, string Name, string Country);
}
