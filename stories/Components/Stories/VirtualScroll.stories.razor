@attribute [Stories("Layout/VirtualScroll")]
@inject IJSRuntime JS

<Stories TComponent="IgbVirtualScroll">

    <ArgType For="_ => _!.Orientation" Control="ControlType.Radio" />

    <Story Name="Default">
        <Arguments>
            <Arg For="_ => _!.Orientation" Value="ContentOrientation.Vertical" />
            <Arg For="_ => _!.OverScan" Value="2" />
            <Arg For="_ => _!.EstimatedItemSize" Value="40" />
        </Arguments>
        <Template>
            @if (_templatesReady)
            {
                <IgbVirtualScroll Data="_items"
                                  ItemTemplateScript="VirtualScrollStoryItemTemplate"
                                  @attributes="context.Args"
                                  style="height: 400px; border: 1px solid gainsboro; border-radius: 4px;" />
            }
        </Template>
    </Story>

    <Story Name="Horizontal">
        <Template>
            @if (_templatesReady)
            {
                <IgbVirtualScroll Data="_items"
                                  Orientation="ContentOrientation.Horizontal"
                                  EstimatedItemSize="140"
                                  ItemTemplateScript="VirtualScrollStoryCardTemplate"
                                  style="height: 120px; border: 1px solid gainsboro; border-radius: 4px;" />
            }
        </Template>
    </Story>

    <Story Name="Infinite Scroll">
        <Template>
            @if (_templatesReady)
            {
                <IgbVirtualScroll Data="_lazyItems"
                                  EstimatedItemSize="40"
                                  ItemTemplateScript="VirtualScrollStoryItemTemplate"
                                  DataRequest="OnDataRequest"
                                  StateChange="OnStateChange"
                                  style="height: 400px; border: 1px solid gainsboro; border-radius: 4px;" />

                <div style="margin-top: 12px; font-family: ui-monospace, monospace; font-size: 0.85rem;">
                    Loaded: @_lazyItems.Length items &nbsp;|&nbsp; @_windowInfo
                </div>
            }
        </Template>
    </Story>

</Stories>

@code {
    public class VirtualItem
    {
        public int Id { get; set; }
        public string Text { get; set; } = string.Empty;
    }

    private static VirtualItem[] MakeItems(int start, int count) =>
        [.. Enumerable.Range(start, count).Select(i => new VirtualItem { Id = i, Text = $"Virtualized item {i}" })];

    private readonly VirtualItem[] _items = MakeItems(1, 10000);

    private VirtualItem[] _lazyItems = MakeItems(1, 50);
    private string _windowInfo = "Scroll to load more.";
    private bool _templatesReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // The client-side item templates must exist before the component first renders,
            // so the virtual scroll is held back until registration completes.
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/VirtualScroll.stories.js");
            await module.InvokeVoidAsync("registerVirtualScrollTemplates");
            _templatesReady = true;
            StateHasChanged();
        }
    }

    private void OnDataRequest(IgbVirtualScrollDataRequestEventArgs args)
    {
        // Append the requested chunk; the component expects a new collection reference.
        var start = (int)args.Detail.StartIndex;
        var count = Math.Max((int)args.Detail.Count, 25);
        _lazyItems = [.. _lazyItems, .. MakeItems(start + 1, count)];
    }

    private void OnStateChange(IgbVirtualScrollStateChangeEventArgs args)
    {
        var detail = args.Detail;
        _windowInfo = $"window: {detail.StartIndex}-{detail.EndIndex} | total: {detail.TotalSize}px";
    }
}
