@attribute [Stories("Forms/ColorPicker")]

<Stories TComponent="IgbColorPicker">

    <ArgType For="_ => _!.Format" Control="ControlType.Radio" />
    <ArgType For="_ => _!.Mode" Control="ControlType.Radio" />

    <Story Name="Default">
        <Arguments>
            <Arg For="_ => _!.Label" Value='"Color"' />
            <Arg For="_ => _!.Value" Value='"#875fc4"' />
            <Arg For="_ => _!.Format" Value="ColorFormat.Hex" />
            <Arg For="_ => _!.Mode" Value="ColorPickerMode.Default" />
            <Arg For="_ => _!.ShowAlpha" Value="false" />
            <Arg For="_ => _!.HideFormats" Value="false" />
            <Arg For="_ => _!.Disabled" Value="false" />
        </Arguments>
        <Template>
            <div style="padding: 60px 60px 360px;">
                <IgbColorPicker @attributes="context.Args" />
            </div>
        </Template>
    </Story>

    <Story Name="Input Mode">
        <Arguments>
            <Arg For="_ => _!.Label" Value='"Accent color"' />
            <Arg For="_ => _!.Mode" Value="ColorPickerMode.Input" />
            <Arg For="_ => _!.Value" Value='"#2979ff"' />
        </Arguments>
        <Template>
            <div style="padding: 60px 60px 360px;">
                <IgbColorPicker @attributes="context.Args" />
            </div>
        </Template>
    </Story>

    <Story Name="With Alpha">
        <Arguments>
            <Arg For="_ => _!.Label" Value='"Overlay color"' />
            <Arg For="_ => _!.ShowAlpha" Value="true" />
            <Arg For="_ => _!.Format" Value="ColorFormat.Rgb" />
            <Arg For="_ => _!.Value" Value='"rgba(41, 121, 255, 0.5)"' />
        </Arguments>
        <Template>
            <div style="padding: 60px 60px 420px;">
                <IgbColorPicker @attributes="context.Args" />
            </div>
        </Template>
    </Story>

    <Story Name="With Swatches">
        <Template>
            <div style="padding: 60px 60px 420px;">
                <IgbColorPicker Label="Brand color" Value="#e91e63" Swatches="_swatches" />
            </div>
        </Template>
    </Story>

    <Story Name="Two-way Binding">
        <Template>
            <div style="padding: 60px 60px 360px;">
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <IgbColorPicker Label="Background" @bind-Value="_boundColor" />
                    <div style="@($"width: 48px; height: 48px; border-radius: 8px; border: 1px solid gainsboro; background: {_boundColor};")"></div>
                    <span style="font-family: ui-monospace, monospace;">@_boundColor</span>
                </div>
            </div>
        </Template>
    </Story>

    <Story Name="Disabled">
        <Arguments>
            <Arg For="_ => _!.Label" Value='"Color"' />
            <Arg For="_ => _!.Value" Value='"#43a047"' />
            <Arg For="_ => _!.Disabled" Value="true" />
        </Arguments>
        <Template>
            <IgbColorPicker @attributes="context.Args" />
        </Template>
    </Story>

</Stories>

@code {
    private readonly string[] _swatches =
    [
        "#e91e63", "#9c27b0", "#3f51b5", "#2196f3", "#009688",
        "#4caf50", "#ffc107", "#ff5722", "#795548", "#607d8b"
    ];

    private string _boundColor = "#875fc4";
}
