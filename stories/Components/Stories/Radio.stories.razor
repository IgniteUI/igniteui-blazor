@attribute [Stories("Forms/Radio")]

<Stories TComponent="IgbRadioGroup<Plan>">

    <ArgType For="_ => _!.Alignment" Control="ControlType.Radio" />

    <Story Name="Default">
        <Arguments>
            <Arg For="_ => _!.Alignment" Value="ContentOrientation.Vertical" />
        </Arguments>
        <Template>
            <IgbRadioGroup TValue="Plan" @attributes="context.Args">
                <IgbRadio Value="Plan.Basic">Basic</IgbRadio>
                <IgbRadio Value="Plan.Pro">Pro</IgbRadio>
                <IgbRadio Value="Plan.Enterprise">Enterprise</IgbRadio>
            </IgbRadioGroup>
        </Template>
    </Story>

    <Story Name="Horizontal">
        <Arguments>
            <Arg For="_ => _!.Alignment" Value="ContentOrientation.Horizontal" />
        </Arguments>
        <Template>
            <IgbRadioGroup TValue="Plan" @attributes="context.Args">
                <IgbRadio Value="Plan.Basic">Basic</IgbRadio>
                <IgbRadio Value="Plan.Pro">Pro</IgbRadio>
                <IgbRadio Value="Plan.Enterprise">Enterprise</IgbRadio>
            </IgbRadioGroup>
        </Template>
    </Story>

    <Story Name="Two-way Binding">
        <Template>
            <IgbRadioGroup @bind-Value="_plan">
                @foreach (var plan in Enum.GetValues<Plan>())
                {
                    <IgbRadio Value="plan">@plan</IgbRadio>
                }
            </IgbRadioGroup>
            <p>Selected: @_plan</p>
        </Template>
    </Story>

</Stories>

@code {
    public enum Plan { Basic, Pro, Enterprise }

    private Plan _plan = Plan.Pro;
}
