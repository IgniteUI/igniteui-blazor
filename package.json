{
  "name": "igniteui-blazor-lite",
  "private": true,
  "scripts": {
    "test": "node --test \"tests/js/**/*.test.mjs\"",
    "build": "tsc --noEmit -p tsconfig.json && vite build && tsc -p tsconfig.api.json",
    "build:dev": "tsc --noEmit -p tsconfig.json && vite build --mode development && tsc -p tsconfig.api.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks"
  },
  "lint-staged": {
    "*.{js,ts,json,yml,yaml,css}": "prettier --write"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.4.1",
    "eslint": "^10.3.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "yargs": "^17.2.1"
  },
  "dependencies": {
    "igniteui-webcomponents": "~7.2.4",
    "lit-html": "^3.3.2"
  }
}
