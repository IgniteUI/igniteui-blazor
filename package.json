{
  "name": "igniteui-blazor-lite",
  "private": true,
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "cross-env NODE_ENV=production node node_modules/webpack/bin/webpack.js --mode production --config ./webpack.config.js  --color --bail",
    "build:dev": "cross-env NODE_ENV=development node node_modules/webpack/bin/webpack.js --mode development --config ./webpack.config.js  --color --bail",
    "copythemes": "ncp node_modules/igniteui-webcomponents/themes ./src/wwwroot/themes",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks"
  },
  "lint-staged": {
    "*.{js,ts,json,yml,yaml,css}": "prettier --write"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^5.2.1",
    "css-loader": "^6.8.1",
    "ejs-loader": "^0.5.0",
    "eslint": "^10.3.0",
    "glob": "^7.1.4",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "lint-staged": "^17.4.1",
    "ncp": "^2.0.0",
    "prettier": "^3.9.5",
    "source-map-loader": "^5.0.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "tslint": "^5.5.0",
    "tslint-loader": "^3.5.3",
    "typescript": "^5.9.3",
    "webpack": "^5.110.2",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "worker-loader": "^3.0.8",
    "yargs": "^17.2.1"
  },
  "dependencies": {
    "igniteui-webcomponents": "~7.3.0",
    "lit-html": "^3.3.3"
  }
}
