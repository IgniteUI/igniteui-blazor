@page "/slider-options"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@* Slider values formatted through options objects, which reach the element only as properties. *@

<IgbSlider id="percent" Value="50" ValueFormatOptions="@_percent"
           PrimaryTicks="3" TickLabelRotation="SliderTickLabelRotation.Ninety" />
<IgbRangeSlider id="currency" Lower="20" Upper="80" ValueFormat="from {0}" ValueFormatOptions="@_currency" />
<IgbSlider id="grouping-never" TValue="double" Value="12" Locale="en-US" ValueFormatOptions="@_groupingNever" />
<IgbSlider id="grouping-min2" TValue="double" Value="12" Locale="en-US" ValueFormatOptions="@_groupingMin2" />

@code {
    private readonly IgbNumberFormatOptions _percent = new() { Style = "unit", Unit = "percent" };
    private readonly IgbNumberFormatOptions _currency = new() { Style = "currency", Currency = "EUR" };
    private readonly IgbNumberFormatOptions _groupingNever = new() { Style = "percent", UseGrouping = NumberFormatGrouping.Never };
    private readonly IgbNumberFormatOptions _groupingMin2 = new() { Style = "percent", UseGrouping = NumberFormatGrouping.Min2 };
}
