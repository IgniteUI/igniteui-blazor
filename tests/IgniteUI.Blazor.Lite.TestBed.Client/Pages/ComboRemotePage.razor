@page "/combo-remote"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using System.Collections.ObjectModel
@implements IDisposable
@inject IJSRuntime JS

@* Combo features of igniteui-webcomponents 7.5: remote filtering (SearchInput / DataRequest),
   the close trigger of Closing / Closed, and the confirm selection mode (PendingChange, a
   single "commit" Change). The handlers record what .NET receives; tests read it through
   window.clientPageRef.GetLog(). Prerender is off, so the combos existing means WASM is live. *@

<div id="container">
    <IgbCombo id="remote" TValue="int" TItem="ComboDataScenarios.Product"
              ValueKey="Id" DisplayKey="Name"
              FilteringOptions="_remoteFiltering"
              Data="_remoteItems"
              TotalItemCount="_remoteTotal"
              SearchInput="OnSearchInput"
              DataRequest="OnDataRequest"
              Closing="OnClosing"
              Closed="OnClosed" />

    <IgbCombo id="confirm" TValue="int" TItem="ComboDataScenarios.Product"
              ValueKey="Id" DisplayKey="Name"
              Data="_confirmItems"
              SelectionCommit="ComboSelectionCommit.Confirm"
              PendingChange="OnPendingChange"
              Change="OnChange" />

    <IgbCombo @ref="_noKey" id="nokey" TValue="ComboDataScenarios.Product" TItem="ComboDataScenarios.Product"
              DisplayKey="Name"
              Data="_noKeyItems"
              Change="OnNoKeyChange" />
</div>

@code {
    private static readonly List<ComboDataScenarios.Product> _catalog = Enumerable.Range(1, 500)
        .Select(i => new ComboDataScenarios.Product { Id = i, Name = $"Product {i:000}", Price = i, Restocked = new DateTime(2026, 1, 1) })
        .ToList();

    private readonly IgbFilteringOptions _remoteFiltering = new() { Mode = ComboFilteringMode.Remote };
    // A search replaces the collection; a page appends to it, so only the new items cross.
    private ObservableCollection<ComboDataScenarios.Product> _remoteItems = new(_catalog.Take(20));
    private double? _remoteTotal = _catalog.Count;
    private string _search = "";
    private readonly List<ComboDataScenarios.Product> _confirmItems = _catalog.Take(5).ToList();

    private readonly List<string> _searchTexts = new();
    private readonly List<string> _requests = new();
    private readonly List<string> _closing = new();
    private readonly List<string> _closed = new();
    private readonly List<string> _pending = new();
    private readonly List<string> _changes = new();
    private readonly List<string> _noKeyChanges = new();
    private List<ComboDataScenarios.Product> _noKeyItems = FreshProducts(1, 5);
    private IgbCombo<ComboDataScenarios.Product, ComboDataScenarios.Product>? _noKey;
    private ComboDataScenarios.Product[] _noKeyValue = [];

    // A server returns new instances on each call, as a deserializer does.
    private static List<ComboDataScenarios.Product> FreshProducts(int first, int count) => Enumerable.Range(first, count)
        .Select(i => new ComboDataScenarios.Product { Id = i, Name = $"Product {i:000}", Price = i, Restocked = new DateTime(2026, 1, 1) })
        .ToList();

    private void OnNoKeyChange(IgbComboChangeEventArgs<ComboDataScenarios.Product, ComboDataScenarios.Product> args) =>
        _noKeyChanges.Add(string.Join(",", (_noKeyValue = args.Detail.NewValue).Select(p => p?.Name ?? "<null>")));

    /// <summary>The selection as .NET reads it back: names, and whether they are the bound instances.</summary>
    [JSInvokable]
    public async Task<string> GetNoKeySelection()
    {
        var selection = await _noKey!.GetSelectionAsync();
        return string.Join(",", selection.Select(p => p?.Name ?? "<null>"));
    }

    /// <summary>Deselects, from .NET, the first selected item: one the current data no longer holds.</summary>
    [JSInvokable]
    public async Task DeselectFirstNoKeyItem()
    {
        await _noKey!.DeselectAsync([_noKeyValue[0]]);
    }

    [JSInvokable]
    public async Task ReplaceNoKeyData()
    {
        await InvokeAsync(() =>
        {
            _noKeyItems = FreshProducts(6, 5);
            StateHasChanged();
        });
    }
    private DotNetObjectReference<ComboRemotePage>? _selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("registerClientPageRef", _selfRef);
        }
    }

    public void Dispose()
    {
        _selfRef?.Dispose();
    }

    private IEnumerable<ComboDataScenarios.Product> Matches() =>
        _catalog.Where(p => p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private void OnSearchInput(IgbComboSearchInputEventArgs args)
    {
        _search = args.Detail.SearchText ?? "";
        _searchTexts.Add(_search);
        var matches = Matches().ToList();
        _remoteItems = new(matches.Take(20));
        _remoteTotal = matches.Count;
    }

    private void OnDataRequest(IgbVirtualScrollDataRequestEventArgs args)
    {
        var start = (int)args.Detail.StartIndex;
        var count = (int)args.Detail.Count;
        _requests.Add($"{start}:{count}");
        // Append from the items already loaded: an earlier request can have covered part of this one.
        foreach (var item in Matches().Skip(_remoteItems.Count).Take(start + count - _remoteItems.Count))
        {
            _remoteItems.Add(item);
        }
    }

    private void OnClosing(IgbComboClosingEventArgs args) => _closing.Add(args.Detail.Trigger?.ToString() ?? "<null>");

    private void OnClosed(IgbComboClosingEventArgs args) => _closed.Add(args.Detail.Trigger?.ToString() ?? "<null>");

    private void OnPendingChange(IgbComboChangeEventArgs<int, ComboDataScenarios.Product> args) =>
        _pending.Add($"{args.Detail.ChangeType}:{string.Join(",", args.Detail.NewValue)}");

    private void OnChange(IgbComboChangeEventArgs<int, ComboDataScenarios.Product> args) =>
        _changes.Add($"{args.Detail.ChangeType}:{string.Join(",", args.Detail.NewValue)}");

    [JSInvokable]
    public object GetLog() => new
    {
        SearchTexts = _searchTexts,
        Requests = _requests,
        Closing = _closing,
        Closed = _closed,
        Pending = _pending,
        Changes = _changes,
        NoKeyChanges = _noKeyChanges,
    };
}
