{
  "IgbCalendar": {
    "ExcludedProps": [
      //BUG 35208
      "FormatOptions",
      "ResourceStrings"
    ],
    "ExcludedEvents": []
  },
  "IgbColorPicker": {
    "ExcludedProps": [
      // The generic sample string is not a valid CSS color and the component clears
      // invalid values by design, so the live property never reflects it back.
      // The unit interop contract covers the value round-trip and the @bind-Value pair.
      "Value"
    ]
  },
  "IgbDatePicker": {
    "ExcludedProps": ["ResourceStrings"],
    "DependantMethods": []
  },
  "IgbDateRangePicker": {
    "ExcludedProps": [
      // BUG 40335
      "CustomRanges",
      // complex object
      "Value",
      // complex object
      "ResourceStrings"
    ],
    "DependantMethods": ["GetCurrentValueAsync"]
  },
  "IgbSelect": {
    "ExcludedProps": [
      // This should not be a property. No idea why it generates as one and why it is settable.
      "EmitEvent"
    ],
    "ExcludedEvents": [
      // Emits complex object, instance of igc-select-item, which we cannot easily mock.
      "Change"
    ],
    "DependantMethods": [
      // BUG 35183
      "FocusComponentAsync"
    ]
  },
  "IgbRadio": {
    "DependantMethods": [
      // BUG 35183
      "FocusComponentAsync"
    ]
  },
  "IgbCombo": {
    "DependantMethods": [
      // BUG 35183
      "FocusComponentAsync"
    ]
  },
  "IgbRating": {
    "DependantMethods": [],
    "ExcludedEvents": []
  },
  "IgbSlider": {
    "DependantMethods": [],
    "ExcludedProps": [
      // BUG 35189
      "ValueFormatOptions"
    ],
    "ExcludedDefaultProps": [
      // Derived on the client, not stored: upperBound reports max and lowerBound reports min
      // while unset, so the wrapper cannot mirror either with a constant initializer.
      "UpperBound",
      "LowerBound"
    ]
  },
  "IgbTextarea": {
    "DependantMethods": [],
    "ExcludedProps": [
      // BUG 35186
      "Spellcheck"
    ]
  },
  "IgbToggleButton": {
    "DependantMethods": [
      // BUG 35183
      "FocusComponentAsync"
    ]
  },
  "IgbTree": {
    "ExcludedProps": [
      // circular ref
      "Parent"
    ]
  },
  "IgbTreeItem": {
    "ExcludedProps": [
      // circular ref
      "Parent",
      // this should not be settable, seems to be related to an the internal component state.
      "Level"
    ]
  },
  "IgbCheckbox": {
    "DependantMethods": [
      // BUG 35183
      "FocusComponentAsync"
    ]
  },
  "IgbIconButton": {
    "DependantMethods": [
      // BUG 35183
      "FocusComponentAsync",
      "BlurComponentAsync"
    ]
  },
  "IgbSwitch": {
    "DependantMethods": [
      // BUG 35183
      "FocusComponentAsync"
    ]
  },
  "IgbButton": {
    "DependantMethods": [
      // BUG 35183
      "FocusComponentAsync",
      "BlurComponentAsync"
    ]
  },
  "IgbButtonGroup": {
    "DependantProps": [
      // selected items can only be set if there're matching buttons in the group
      "SelectedItems"
    ]
  },
  "IgbDialog": {
    "ExcludedProps": [
      // BUG 35188
      "ReturnValue"
    ]
  },
  "IgbStep": {
    "DependantMethods": [
      // BUG 35185
      "ToggleAnimationAsync"
    ]
  },
  "IgbCarouselSlide": {
    "DependantMethods": [
      // BUG 35185
      "ToggleAnimationAsync"
    ]
  },
  "IgbTab": {
    "DependantMethods": [
      // BUG 35183
      "FocusAsync"
    ],
    "ExcludedEvents": [
      // no such client event.
      "SelectedChanged"
    ]
  },
  "IgbDateTimeInput": {
    "ExcludedProps": [
      // BUG 35187
      "SpinDelta"
    ],
    "DependantMethods": [
      // BUG 35183
      "FocusComponentAsync"
    ]
  },
  "IgbMaskInput": {
    "ExcludedEvents": [
      // no such client event.
      "ValueChanging"
    ],
    "DependantMethods": [
      // BUG 35183
      "FocusComponentAsync"
    ]
  },
  "IgbInput": {
    "ExcludedProps": [
      // Temporary exclude since these are string, but should be numbers.
      "Min",
      "Max"
    ],
    "DependantMethods": [
      // Depends on the input beign numeric.
      "StepUpAsync",
      "StepDownAsync",
      // BUG 35183
      "FocusComponentAsync"
    ],
    "ExcludedEvents": [
      // no such client event.
      "ValueChanging"
    ]
  },
  "IgbRangeSlider": {
    "ExcludedProps": [
      // BUG 35189
      "ValueFormatOptions"
    ],
    "ExcludedDefaultProps": [
      // Derived on the client, not stored: upperBound reports max and lowerBound reports min
      // while unset, so the wrapper cannot mirror either with a constant initializer.
      "UpperBound",
      "LowerBound"
    ]
  },
  "IgbStepper": {
    "ExcludedProps": [
      // This is a collection of nested IgbStep components, it should probably be only a getter.
      "Steps"
    ],
    "DependantMethods": [
      // Depends on having at least one child step, otherwise throws error.
      "NextAsync",
      "PrevAsync"
    ]
  },
  "IgbSelectGroup": {
    "ExcludedProps": [
      // This is a collection of nested IgbSelectItem components, it should probably be only a getter.
      "Items"
    ]
  }
