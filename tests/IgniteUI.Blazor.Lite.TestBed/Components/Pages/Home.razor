@page "/"
@using IgniteUI.Blazor.Lite.TestBed.Components.Common
@using IgniteUI.Blazor.Controls
@using System.Reflection
@using Newtonsoft.Json
@inject IJSRuntime JS

<PageTitle>Home</PageTitle>

@if (selectedType is not null)
{
    <div id="container">
        <DynamicComponent Type="selectedType" Parameters="componentParameters" @ref="dc">
        </DynamicComponent>
    </div>
}



@code {

    private static Home? _app;
    private string componentSelector = string.Empty;
    private Type? selectedType;
    private DynamicComponent? dc;
    private Dictionary<string, object> componentParameters = new();
    private List<string> errorMessages = new List<string>();
    private string eventMessage = string.Empty;
    private ComponentRunSummary summary = new();

    // BaseRendererControl.QueueUpdate flushes to the client on a queued, fire-and-forget pass
    // timed by the thread pool, so wait for results to show up, not for a fixed delay.
    private const int PropagationTimeoutMs = 1000;
    private const int PollIntervalMs = 20;

    private IConfigurationRoot config;

    public Home()
    {
        _app = this;
        config = new ConfigurationBuilder()
            .SetBasePath(AppContext.BaseDirectory)
            .AddJsonFile("componentsConfig.json", optional: true, reloadOnChange: true)
            .Build();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("onAfterRender");
        }
    }

    [JSInvokable("GetErrors")]
    public static List<string> GetErrors()
    {
        return _app?.errorMessages ?? new List<string>();
    }

    [JSInvokable("SetComponentType")]
    public static async Task<ComponentRunSummary> SetComponentType(string type)
    {
        var app = _app;
        if (app == null)
        {
            return ComponentRunSummary.Failed(type, "the test bed page is not initialized");
        }

        var component = ReflectionUtils.GetComponentByType(type);
        if (component == null)
        {
            return ComponentRunSummary.Failed(type, "no component type matches that name");
        }

        app.errorMessages.Clear();
        app.summary = new ComponentRunSummary { Component = type };
        app.selectedType = component;

        ReflectionUtils.excludedProps = app.config.GetSection(type + ":ExcludedProps")?.Get<string[]>()?.ToList() ?? new List<string>();
        ReflectionUtils.dependantProps = app.config.GetSection(type + ":DependantProps")?.Get<string[]>()?.ToList() ?? new List<string>();
        ReflectionUtils.dependantMethods = app.config.GetSection(type + ":DependantMethods")?.Get<string[]>()?.ToList() ?? new List<string>();
        ReflectionUtils.excludedEvents = app.config.GetSection(type + ":ExcludedEvents")?.Get<string[]>()?.ToList() ?? new List<string>();
        ReflectionUtils.excludedDefaultProps = app.config.GetSection(type + ":ExcludedDefaultProps")?.Get<string[]>()?.ToList() ?? new List<string>();

        app.StateHasChanged();
        await Task.Delay(1);

        if (app.dc?.Instance is not BaseRendererControl renderer)
        {
            return ComponentRunSummary.Failed(type, "the rendered component is not a BaseRendererControl");
        }

        await renderer.EnsureReady();
        await Task.Delay(100);

        app.componentSelector = ReflectionUtils.GetComponentSelector(app.dc.Instance, type);
        app.summary.Selector = app.componentSelector;
        await app.JS.InvokeAsync<string>("setSelector", app.componentSelector);

        app.componentParameters = new Dictionary<string, object>();

        // Defaults first: it is the only point where nothing has been assigned yet.
        await app.TestPropDefaults();
        await app.TestEvents();
        await app.TestServerTemplates();
        await app.TestClientTemplates();
        await app.TestProps();
        await app.TestAPI();

        app.summary.Errors = app.errorMessages.Count;

        return app.summary;
    }

    public async Task TestServerTemplates()
    {
        if (selectedType == null || dc == null)
        {
            return;
        }

        var parameters = componentParameters;
        var tmpls = selectedType.GetProperties(BindingFlags.Public | BindingFlags.Instance | System.Reflection.BindingFlags.DeclaredOnly)
       .Where(x => ReflectionUtils.IsRenderFragment(x)).ToList();
        foreach (var tmpl in tmpls)
        {
            var arg = tmpl.PropertyType.GenericTypeArguments[0];
            var instance = Activator.CreateInstance(arg);
            var r = ReflectionUtils.CreateRenderFragmentForType(arg, instance!);

            parameters.Add(tmpl.Name, r);
            StateHasChanged();
            var clientPropName = char.ToLower(tmpl.Name[0]) + tmpl.Name.Substring(1);
            var res = await WaitForClientCheck("checkServerTemplate", clientPropName);
            summary.ServerTemplates++;

            if (!res)
            {
                errorMessages.Add("Template not set for prop:  " + tmpl.Name);
            }
        }
    }

    public async Task TestClientTemplates()
    {
        if (selectedType == null || dc == null)
        {
            return;
        }

        var parameters = componentParameters;
        var tmplsNames = selectedType.GetProperties(BindingFlags.Public | BindingFlags.Instance | System.Reflection.BindingFlags.DeclaredOnly)
    .Where(x => ReflectionUtils.IsRenderFragment(x)).Select(x => x.Name).ToList();
        var scriptTemplateProps = selectedType.GetProperties(BindingFlags.Public | BindingFlags.Instance | System.Reflection.BindingFlags.DeclaredOnly)
    .Where(x => x.Name.EndsWith("Script") && tmplsNames.Contains(x.Name.Replace("Script", ""))).ToList();
        foreach (var scriptProp in scriptTemplateProps)
        {
            var tmplName = ReflectionUtils.Camelize(scriptProp.Name.Replace("Script", ""));
            await JS.InvokeVoidAsync("generateClientTmpl", tmplName);
            parameters.Add(scriptProp.Name, tmplName);
            StateHasChanged();

            var res = await WaitForClientCheck("checkClientTemplate", tmplName);
            summary.ClientTemplates++;
            if (!res)
            {
                errorMessages.Add("Template not set for prop:  " + scriptProp.Name);
            }
        }

    }

    public async Task TestAPI()
    {
        if (selectedType == null || dc == null)
        {
            return;
        }

        var componentInstance = dc.Instance;
        if (componentInstance == null)
        {
            return;
        }

        var methods = ReflectionUtils.GetValidMethods(selectedType);
        foreach (var method in methods)
        {
            var parameters = new List<object>();
            if (CustomTypes.PredefinedMethodArgs.ContainsKey(method.Name))
            {
                // this is a special method that needs special values
                parameters.AddRange(CustomTypes.PredefinedMethodArgs[method.Name]);
            }
            else
            {
                var paramInfo = method.GetParameters();
                int count = 0;
                foreach (var p in paramInfo)
                {
                    var obj = ReflectionUtils.GetObjectOfType(p.ParameterType);
                    parameters.Add(obj!);
                    count++;
                }
            }
            var syncName = method.Name.Replace("Async", "");
            var clientMethodName = ReflectionUtils.Camelize(syncName);
            summary.Methods++;
            await JS.InvokeVoidAsync("spyOnMethod", clientMethodName);
            object? res = null;
            try
            {
                res = await IgniteUI.Blazor.Lite.TestBed.Components.Common.Helper.InvokeAsync(method, componentInstance, parameters.ToArray());

            }
            catch (Exception e)
            {
                // push any errors in collection
                errorMessages.Add("Error on method: " + method.Name + ". Details: " + e.Message);
            }
            var expected = Newtonsoft.Json.JsonConvert.SerializeObject(res);
            if (res == null || res.GetType().Name == "VoidTaskResult")
            {
                // method returns void
                expected = "null";
            }
            var actualResult = await JS.InvokeAsync<string>("checkOnSpy", clientMethodName);
            if (actualResult == null)
            {
                actualResult = "null";
            }

            if (actualResult != expected)
            {
                errorMessages.Add("Method result mismatch after calling. Method name:  " + method.Name + ". Expected:" + expected + ", but got: " + actualResult);
            }

        }
    }

    /// <summary>
    /// The reverse of <see cref="TestProps"/>: instead of setting a value and checking it reaches
    /// the client, this reads what the client component starts with and checks the wrapper reports
    /// the same. Runs before any property is set, since that is the only moment the defaults are still intact.
    /// </summary>
    public async Task TestPropDefaults()
    {
        if (selectedType == null || dc == null)
        {
            return;
        }

        var props = ReflectionUtils.GetValidProps(selectedType)
            .Where(x => TestUtil.HasComparableDefault(x) && !ReflectionUtils.excludedDefaultProps.Contains(x.Name));

        foreach (var p in props)
        {
            var serverValue = p.GetValue(dc.Instance);
            if (serverValue == null)
            {
                continue;
            }

            var clientPropName = ReflectionUtils.GetActualPropertyName(p);
            var clientValue = await GetClientPropValue(clientPropName);
            if (clientValue == null || clientValue == "undefined")
            {
                // The component does not expose the member yet (lazily created), nothing to compare.
                continue;
            }

            summary.Defaults++;

            if (!TestUtil.PropertyValuesAreEqual(serverValue, clientValue, p))
            {
                var serverString = serverValue is Enum
                    ? TestUtil.EnumActualValue(serverValue)
                    : serverValue.ToString();
                this.errorMessages.Add("Default value mismatch before setting. Prop name:  " + p.Name
                    + ". The wrapper reports:" + serverString
                    + ", but the client component starts with: " + clientValue);
            }
        }
    }

    public async Task TestProps()
    {
        if (selectedType == null || dc == null)
        {
            return;
        }

        var parameters = componentParameters;
        var props = ReflectionUtils.GetValidProps(selectedType);

        foreach (var p in props)
        {
            object? value;
            try
            {
                value = ReflectionUtils.GetObjectOfType(p.PropertyType, p.Name == "Data");
            }
            catch (Exception)
            {
                // if object cannot resolve, perhaps it needs to be defined as CustomType?
                continue;
            }
            if (CustomTypes.PredefinedPropertyValues.ContainsKey(p.Name))
            {
                // this is a special property with predefined value
                value = CustomTypes.PredefinedPropertyValues[p.Name];
            }
            // set prop and wait for state to change
            parameters.Add(p.Name, value!);
            StateHasChanged();

            var clientPropName = ReflectionUtils.GetActualPropertyName(p);
            var clientValue = await WaitForClientPropValue(clientPropName, value, p);
            summary.Properties++;
            if (!TestUtil.PropertyValuesAreEqual(value, clientValue, p))
            {
                string serverString = value is Enum ?
               value.ToString()?.ToLowerInvariant() ?? string.Empty :
               JsonConvert.SerializeObject(value, new JsonSerializerSettings()
                    { ContractResolver = new IgnorePropertiesResolver(ReflectionUtils.IgnoredProps().ToArray()) });
                this.errorMessages.Add("Property value mismatch after setting. Prop name:  " + p.Name + ". Expected:" + serverString + ", but got the following on the client: " + clientValue);
            }
        }
    }

    /// <summary>
    /// Reads the client value, retrying until it matches what was set or the timeout runs out.
    /// </summary>
    private async Task<string> WaitForClientPropValue(string clientPropName, object? expected, PropertyInfo prop)
    {
        var clientValue = await GetClientPropValue(clientPropName);
        for (var waited = 0;
            waited < PropagationTimeoutMs && !TestUtil.PropertyValuesAreEqual(expected, clientValue, prop);
            waited += PollIntervalMs)
        {
            await Task.Delay(PollIntervalMs);
            clientValue = await GetClientPropValue(clientPropName);
        }

        return clientValue;
    }

    /// <summary>
    /// Runs a client-side check, retrying until it reports true or the timeout runs out.
    /// </summary>
    private async Task<bool> WaitForClientCheck(string jsFunction, string arg)
    {
        var result = await JS.InvokeAsync<bool>(jsFunction, arg);
        for (var waited = 0; waited < PropagationTimeoutMs && !result; waited += PollIntervalMs)
        {
            await Task.Delay(PollIntervalMs);
            result = await JS.InvokeAsync<bool>(jsFunction, arg);
        }

        return result;
    }

    // in cases of slower operations, connection closes and execution stops, hence adding a try catch with a 5 second timeout and retry if needed.
    public async Task<string> GetClientPropValue(string propName, int retry = 1)
    {
        string res = "";
        try
        {
            TimeSpan span = new TimeSpan(0, 0, 5);
            res = await JS.InvokeAsync<string>("checkProp", span, propName);
        }
        catch (Exception e)
        {
            if (retry > 0)
            {
                retry--;
                res = await GetClientPropValue(propName, retry);
            }
            else
            {
                this.errorMessages.Add("Property check failed. Prop name:  " + propName + " , Error:" + e.Message);
            }
        }
        return res;
    }

    public async Task TestEvents()
    {
        if (selectedType == null || dc == null)
        {
            return;
        }

        // filter out any events that blazor may have generated that do not exits on the original class
        // var originalEvents = ReflectionUtils.GetOriginEvents(selectedType);
        var parameters = componentParameters;
        var twoWayBoundEvents = ReflectionUtils.Get2WayBindingEvents(selectedType);
        var events = selectedType.GetProperties(BindingFlags.Public | BindingFlags.Instance)
        .Where(x => ReflectionUtils.IsEventCallback(x))
        .Where(x => !ReflectionUtils.excludedEvents.Contains(x.Name))
        .Where(x => !twoWayBoundEvents.Contains(x.Name));

        foreach (var evt in events)
        {
            // hook events
            var arg = evt.PropertyType.GenericTypeArguments[0];
            var detailType = ReflectionUtils.GetOriginEventDetailType(arg, selectedType);
            object? argDetailToSend = null;
            if (detailType != null)
            {
                argDetailToSend = ReflectionUtils.GetSimpleType(detailType);
            }
            var instance = Activator.CreateInstance(evt.PropertyType, [this, (Action)(() => eventMessage = evt.Name)]);
            if (instance == null)
            {
                continue;
            }

            parameters.Add(evt.Name, instance);

            StateHasChanged();
            var evtName = evt.Name == "Focus" || evt.Name == "Blur" ? evt.Name.ToLower() : "igc" + evt.Name;

            // event is renamed on the client side, so we need to handle that case
            if (evt.Name == "InputOcurred")
            {
                evtName = "igcInput";
            }

            if (evt.Name == "SelectionChanged")
            {
                evtName = "igcSelection";
            }

            eventMessage = "";
            summary.Events++;

            // The client-side subscription lands on the same flush as properties, so an event
            // dispatched too early goes nowhere; re-dispatch until it takes. Matching on the
            // name keeps a late duplicate from reading as the next event firing.
            for (var waited = 0; waited < PropagationTimeoutMs; waited += PollIntervalMs)
            {
                await Task.Delay(PollIntervalMs);
                if (eventMessage == evt.Name)
                {
                    break;
                }

                await JS.InvokeAsync<object>("triggerEvent", evtName, argDetailToSend, detailType == typeof(DateTime));
            }

            if (eventMessage != evt.Name)
            {
                this.errorMessages.Add("Event with name: " + evt.Name + " did not fire.");
            }
        }
    }
}
