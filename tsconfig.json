{
  "compilerOptions": {
    "target": "es2022",
    // igniteui-core (translated) redeclares base-class fields and relies on assignment ([[Set]]) semantics.
    "useDefineForClassFields": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "outDir": "src/dist",
    "lib": ["es2022", "dom"],
    // No automatic @types/*: browser code sees DOM types only.
    "types": [],
    "noImplicitAny": false,
    "removeComments": true,
    "baseUrl": ".",
    "paths": {
      "igniteui-core/*": ["src/src/ig/igniteui-core/*"],
      // igniteui-webcomponents modules api.js imports directly, as the package index would pull every component into it
      // (loaded eagerly by the initializer). Not in the package exports map; vite resolves them from here as well.
      "igniteui-webcomponents/components/icon/icon.registry.js": [
        "node_modules/igniteui-webcomponents/components/icon/icon.registry.js"
      ]
    }
  },
  "exclude": ["node_modules", "src/dist", "src/wwwroot", "vite.config.mts"]
}
