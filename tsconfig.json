{
  "compilerOptions": {
    "target": "es2022",
    // igniteui-core (translated) redeclares base-class fields and relies on assignment ([[Set]]) semantics.
    "useDefineForClassFields": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "outDir": "src/dist",
    "lib": ["es2022", "dom"],
    // No automatic @types/*: browser code sees DOM types only.
    "types": [],
    "noImplicitAny": false,
    "removeComments": true,
    "baseUrl": ".",
    "paths": {
      "igniteui-core/*": ["src/src/ig/igniteui-core/*"]
    }
  },
  "exclude": ["node_modules", "src/dist", "src/wwwroot", "vite.config.mts"]
}
