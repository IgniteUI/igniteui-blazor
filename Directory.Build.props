<Project>
  <PropertyGroup>
    <Company>Infragistics</Company>
    <Copyright>Infragistics</Copyright>
    <Deterministic>true</Deterministic>
    <Nullable>enable</Nullable>
    <!-- Every compiler, analyzer and NuGet warning as error in build and in IDEs.
         Rules/categories and severity configured in .editorconfig -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- TEMPORARY: disable NU1903 so automatic dependency submission can restore & Dependabot can fix. Remove once those land. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1903</WarningsNotAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Run the .editorconfig IDExxxx style rules as analyzers during build
         so formatting violations surface as warnings locally and in CI. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
