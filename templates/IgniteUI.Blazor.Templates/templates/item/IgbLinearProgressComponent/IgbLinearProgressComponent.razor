@page "/IgbLinearProgressComponent"
@using IgniteUI.Blazor.Controls

<PageTitle>IgbLinearProgressComponent</PageTitle>

<h3>IgbLinearProgressComponent</h3>

<div class="controls">
    <div class="control">
        <label>Value: @Value</label>
        <div class="control-box">
            <IgbSlider class="value-slider" @bind-Value="Value" Min="0" Max="100" Step="1" />
        </div>
    </div>

    <div class="control">
        <label>Variant</label>
        <div class="control-box">
            <IgbRadioGroup Alignment="ContentOrientation.Horizontal" @bind-Value="Variant">
                <IgbRadio Value="StyleVariant.Primary">Primary</IgbRadio>
                <IgbRadio Value="StyleVariant.Info">Info</IgbRadio>
                <IgbRadio Value="StyleVariant.Success">Success</IgbRadio>
                <IgbRadio Value="StyleVariant.Warning">Warning</IgbRadio>
                <IgbRadio Value="StyleVariant.Danger">Danger</IgbRadio>
            </IgbRadioGroup>
        </div>
    </div>

    <div class="control">
        <label>Label align</label>
        <div class="control-box">
            <IgbRadioGroup Alignment="ContentOrientation.Horizontal" @bind-Value="LabelAlign">
                <IgbRadio Value="LinearProgressLabelAlign.TopStart">TopStart</IgbRadio>
                <IgbRadio Value="LinearProgressLabelAlign.Top">Top</IgbRadio>
                <IgbRadio Value="LinearProgressLabelAlign.TopEnd">TopEnd</IgbRadio>
                <IgbRadio Value="LinearProgressLabelAlign.BottomStart">BottomStart</IgbRadio>
                <IgbRadio Value="LinearProgressLabelAlign.Bottom">Bottom</IgbRadio>
                <IgbRadio Value="LinearProgressLabelAlign.BottomEnd">BottomEnd</IgbRadio>
            </IgbRadioGroup>
        </div>
    </div>

    <div class="control">
        <label>Options</label>
        <div class="control-box switches">
            <IgbSwitch @bind-Checked="Striped">Striped</IgbSwitch>
            <IgbSwitch @bind-Checked="Indeterminate">Indeterminate</IgbSwitch>
            <IgbSwitch @bind-Checked="HideLabel">Hide label</IgbSwitch>
        </div>
    </div>
</div>

<div class="component-host">
    <IgbLinearProgress class="demo-progress"
                       Value="Value"
                       Variant="Variant"
                       LabelAlign="LabelAlign"
                       Striped="Striped"
                       Indeterminate="Indeterminate"
                       HideLabel="HideLabel" />
</div>

<div class="state">Value: @Value% &nbsp;|&nbsp; Variant: @Variant</div>

@code {
    /*
     * Ignite UI for Blazor - open-source (MIT) component from IgniteUI.Blazor.Lite.
     * An item template can't modify project files, so do this once per project:
     *
     * 1. Install:   dotnet add package IgniteUI.Blazor.Lite
     * 2. Register (Program.cs):   builder.Services.AddIgniteUIBlazor();
     * 3. _Imports.razor:          @using IgniteUI.Blazor.Controls
     *    (optional here — this file already declares its own @using;
     *    add it to _Imports.razor to share it project-wide)
     * 4. Host page theme (index.html / App.razor / _Host.cshtml):
     *    <link href="_content/IgniteUI.Blazor/themes/light/bootstrap.css" rel="stylesheet" />
     * 5. Blazor Web App (.NET 8+): add an interactive render mode to this page,
     *    e.g. @rendermode InteractiveServer (or InteractiveWebAssembly / InteractiveAuto).
     *
     * Do not mix IgniteUI.Blazor.Lite with the licensed IgniteUI.Blazor package.
     */

    private double Value { get; set; } = 75;

    private StyleVariant Variant { get; set; } = StyleVariant.Primary;

    private LinearProgressLabelAlign LabelAlign { get; set; } = LinearProgressLabelAlign.TopStart;

    private bool Striped { get; set; }
    private bool Indeterminate { get; set; }
    private bool HideLabel { get; set; }
}
