@page "/IgbQrCodeComponent"
@using IgniteUI.Blazor.Controls

<PageTitle>IgbQrCodeComponent</PageTitle>

<h3>IgbQrCodeComponent</h3>

<div class="controls">
    <div class="control">
        <label>Error level</label>
        <div class="control-box">
            <IgbRadioGroup Alignment="ContentOrientation.Horizontal" @bind-Value="ErrorLevelName">
                <IgbRadio Value="Low">L</IgbRadio>
                <IgbRadio Value="Medium">M</IgbRadio>
                <IgbRadio Value="Quartile">Q</IgbRadio>
                <IgbRadio Value="High">H</IgbRadio>
            </IgbRadioGroup>
        </div>
    </div>

    <div class="control">
        <label>Dot style</label>
        <div class="control-box">
            <IgbRadioGroup Alignment="ContentOrientation.Horizontal" @bind-Value="DotStyleName">
                <IgbRadio Value="Square">Square</IgbRadio>
                <IgbRadio Value="Circle">Circle</IgbRadio>
                <IgbRadio Value="Rounded">Rounded</IgbRadio>
            </IgbRadioGroup>
        </div>
    </div>

    <div class="control">
        <label>Size: @Size px</label>
        <div class="control-box">
            <IgbSlider class="value-slider" @bind-Value="Size" Min="96" Max="320" Step="16" />
        </div>
    </div>

    <div class="control">
        <label>Content</label>
        <div class="control-box">
            <IgbInput class="value-input" @bind-Value="Value" Label="Encoded value" />
        </div>
    </div>
</div>

<div class="component-host">
    <IgbQrCode Value="@Value"
               Size="Size"
               ErrorLevel="ErrorLevel"
               DotStyle="DotStyle"
               SquareStyle="SquareStyle" />
</div>

<div class="state">Value: @Value &nbsp;|&nbsp; Error level: @ErrorLevelName &nbsp;|&nbsp; Size: @Size</div>

@code {
    /*
     * Ignite UI for Blazor - open-source (MIT) component from IgniteUI.Blazor.Lite.
     * An item template can't modify project files, so do this once per project:
     *
     * 1. Install:   dotnet add package IgniteUI.Blazor.Lite
     * 2. Register (Program.cs):   builder.Services.AddIgniteUIBlazor();
     * 3. _Imports.razor:          @using IgniteUI.Blazor.Controls
     *    (optional here — this file already declares its own @using;
     *    add it to _Imports.razor to share it project-wide)
     * 4. Host page theme (index.html / App.razor / _Host.cshtml):
     *    <link href="_content/IgniteUI.Blazor/themes/light/bootstrap.css" rel="stylesheet" />
     * 5. Blazor Web App (.NET 8+): add an interactive render mode to this page,
     *    e.g. @rendermode InteractiveServer (or InteractiveWebAssembly / InteractiveAuto).
     *
     * Do not mix IgniteUI.Blazor.Lite with the licensed IgniteUI.Blazor package.
     */

    private string ErrorLevelName { get; set; } = "Medium";
    private QrErrorCorrectionLevel ErrorLevel => Enum.Parse<QrErrorCorrectionLevel>(ErrorLevelName);

    private string DotStyleName { get; set; } = "Square";
    private QrDotStyle DotStyle => Enum.Parse<QrDotStyle>(DotStyleName);
    private QrCornerSquareStyle SquareStyle => Enum.Parse<QrCornerSquareStyle>(DotStyleName);

    private double Size { get; set; } = 192;
    private string Value { get; set; } = "https://www.infragistics.com";
}
