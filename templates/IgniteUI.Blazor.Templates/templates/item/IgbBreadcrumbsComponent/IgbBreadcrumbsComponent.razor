@page "/IgbBreadcrumbsComponent"
@using IgniteUI.Blazor.Controls

<PageTitle>IgbBreadcrumbsComponent</PageTitle>

<h3>IgbBreadcrumbsComponent</h3>

<div class="controls">
    <div class="control">
        <label>Separator</label>
        <IgbSelect @bind-Value="Separator">
            @foreach (var separator in Separators)
            {
                <IgbSelectItem Value="@separator">@separator</IgbSelectItem>
            }
        </IgbSelect>
    </div>

    <div class="control">
        <label>Open a folder</label>
        <div class="control-box folders">
            @foreach (var folder in Subfolders)
            {
                <IgbButton Variant="ButtonVariant.Outlined" @onclick="@(() => Trail.Add(folder))">@folder</IgbButton>
            }
        </div>
    </div>
</div>

<div class="component-host">
    <nav aria-label="Breadcrumb">
        <IgbBreadcrumbs Separator="@Separator">
            @for (var i = 0; i < Trail.Count; i++)
            {
                var depth = i;
                var isCurrent = depth == Trail.Count - 1;
                <IgbBreadcrumb @key="@($"{depth}-{Trail[depth]}")" Current="isCurrent">
                    <a href="#" @onclick="@(() => NavigateTo(depth))" @onclick:preventDefault>@Trail[depth]</a>
                </IgbBreadcrumb>
            }
        </IgbBreadcrumbs>
    </nav>
</div>

<div class="state">Location: /@string.Join("/", Trail.Skip(1))</div>

@code {
    /*
     * Ignite UI for Blazor - open-source (MIT) component from IgniteUI.Blazor.Lite.
     * An item template can't modify project files, so do this once per project:
     *
     * 1. Install:   dotnet add package IgniteUI.Blazor.Lite
     * 2. Register (Program.cs):   builder.Services.AddIgniteUIBlazor();
     * 3. _Imports.razor:          @using IgniteUI.Blazor.Controls
     *    (optional here — this file already declares its own @using;
     *    add it to _Imports.razor to share it project-wide)
     * 4. Host page theme (index.html / App.razor / _Host.cshtml):
     *    <link href="_content/IgniteUI.Blazor/themes/light/bootstrap.css" rel="stylesheet" />
     * 5. Blazor Web App (.NET 8+): add an interactive render mode to this page,
     *    e.g. @rendermode InteractiveServer (or InteractiveWebAssembly / InteractiveAuto).
     *
     * Do not mix IgniteUI.Blazor.Lite with the licensed IgniteUI.Blazor package.
     */

    // Icons from the built-in "default" collection, which the separator icon uses.
    private static readonly string[] Separators = { "tree_expand", "chevron_right", "arrow_next" };
    private static readonly string[] Subfolders = { "Documents", "Projects", "Reports", "2026" };

    private string Separator { get; set; } = "tree_expand";
    private List<string> Trail { get; } = new() { "Home" };

    private void NavigateTo(int depth) => Trail.RemoveRange(depth + 1, Trail.Count - depth - 1);
}
