@page "/IgbVirtualScrollComponent"
@using IgniteUI.Blazor.Controls
@inject IJSRuntime JS

<PageTitle>IgbVirtualScrollComponent</PageTitle>

<h3>IgbVirtualScrollComponent</h3>

<div class="controls">
    <div class="control">
        <label>Orientation</label>
        <div class="control-box">
            <IgbRadioGroup Alignment="ContentOrientation.Horizontal" @bind-Value="OrientationName">
                <IgbRadio Value="Vertical">Vertical</IgbRadio>
                <IgbRadio Value="Horizontal">Horizontal</IgbRadio>
            </IgbRadioGroup>
        </div>
    </div>

    <div class="control">
        <label>Over scan: @OverScan items</label>
        <div class="control-box">
            <IgbSlider class="value-slider" @bind-Value="OverScan" Min="0" Max="10" Step="1" />
        </div>
    </div>
</div>

<div class="component-host">
    @if (TemplatesReady)
    {
        <IgbVirtualScroll Data="Items"
                          Orientation="Orientation"
                          OverScan="OverScan"
                          EstimatedItemSize="40"
                          ItemTemplateScript="IgbVirtualScrollComponentItemTemplate"
                          StateChange="OnStateChange"
                          class="virtual-scroll" />
    }
</div>

<div class="state">Items: @Items.Length &nbsp;|&nbsp; @WindowInfo</div>

@code {
    /*
     * Ignite UI for Blazor - open-source (MIT) component from IgniteUI.Blazor.Lite.
     * An item template can't modify project files, so do this once per project:
     *
     * 1. Install:   dotnet add package IgniteUI.Blazor.Lite
     * 2. Register (Program.cs):   builder.Services.AddIgniteUIBlazor();
     * 3. _Imports.razor:          @using IgniteUI.Blazor.Controls
     *    (optional here — this file already declares its own @using;
     *    add it to _Imports.razor to share it project-wide)
     * 4. Host page theme (index.html / App.razor / _Host.cshtml):
     *    <link href="_content/IgniteUI.Blazor/themes/light/bootstrap.css" rel="stylesheet" />
     * 5. Blazor Web App (.NET 8+): add an interactive render mode to this page,
     *    e.g. @rendermode InteractiveServer (or InteractiveWebAssembly / InteractiveAuto).
     *
     * Do not mix IgniteUI.Blazor.Lite with the licensed IgniteUI.Blazor package.
     *
     * The item template is a client-side function in the collocated
     * IgbVirtualScrollComponent.razor.js file. The import below assumes this page
     * lives in Components/Pages — adjust the path if you place it elsewhere.
     */

    private string OrientationName { get; set; } = "Vertical";
    private ContentOrientation Orientation => Enum.Parse<ContentOrientation>(OrientationName);

    private double OverScan { get; set; } = 2;

    private bool TemplatesReady { get; set; }
    private string WindowInfo { get; set; } = "Scroll to render more items.";

    private record Item(int Id, string Text);

    private static Item[] Items { get; } =
        [.. Enumerable.Range(1, 10000).Select(i => new Item(i, $"Virtualized item {i}"))];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // The client-side item template must exist before the component first renders,
            // so the virtual scroll is held back until registration completes.
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/IgbVirtualScrollComponent.razor.js");
            await module.InvokeVoidAsync("registerItemTemplate");
            TemplatesReady = true;
            StateHasChanged();
        }
    }

    private void OnStateChange(IgbVirtualScrollStateChangeEventArgs args)
    {
        var detail = args.Detail;
        WindowInfo = $"Window: {detail.StartIndex}-{detail.EndIndex} | Total: {detail.TotalSize}px";
    }
}
